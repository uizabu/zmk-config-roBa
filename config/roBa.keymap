#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    bindings = <&kp>, <&kp>;

    tapping-term-ms = <400>;
};

// 長押しの途中で別のキーを押して離したら、その時点でレイヤーを切り替える

&lt {
    flavor = "balanced";
    tapping-term-ms = <400>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <6>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // クリック後はマウスレイヤー(4)を抜け、代わりに MOUSE_AFTER_CLICK(5) を1秒だけ有効にする。
        // その間にボールを動かすとレイヤー4が再び有効になり、1秒経ってもクリックのまま。

        mkp_exit_AML: mkp_ext_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 5 &tog_off 4>;

            label = "MKP_EXIT_AML";
        };
    };

    behaviors {
        // 新しいスクロール動作の追加

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // B 用。文字キーなので、0.4秒押し続けたときだけレイヤーを切り替える（打鍵中の誤爆防止）

        lt_slow: lt_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&mo>, <&kp>;
            display-name = "Layer-Tap (slow)";
        };

        // Q の位置用。0.4秒押し続けたときだけ Esc（他のキーと重ねて打っても Esc にならない）

        esc_hold: esc_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&kp>, <&kp>;
            display-name = "Esc Hold";
        };

        // マウスレイヤーの Q の位置用。単押しは通常レイヤーに戻って Q を入力

        esc_hold_to0: esc_hold_to0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&kp>, <&to_layer_0>;
            display-name = "Esc Hold (exit mouse)";
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
            display-name = "Layer Off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&esc_hold ESCAPE Q  &kp W         &kp E             &kp R          &kp T                                                  &kp Y        &kp U  &kp I      &kp O       &kp P
&mt JP_AT A         &mt DOLLAR S  &kp D             &kp F          &kp G        &trans            &mt JP_DQUOTE JP_QUOTE  &kp H        &kp J  &kp K      &kp L       &kp MINUS
&kp LEFT_SHIFT      &kp Z         &kp X             &kp C          &kp V        &lt_slow 7 B      &kp JP_UNDERSCORE       &kp N        &kp M  &kp COMMA  &kp PERIOD  &mt EXCLAMATION QUESTION
&kp LCTRL           &kp LEFT_WIN  &mt LEFT_ALT TAB  &kp JP_HANZEN  &lt 2 SPACE  &lt 3 K_BACK      &kp BACKSPACE           &lt 1 ENTER                                &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        FUNCTION {
            bindings = <
&trans  &mt F11 F1  &mt F12 F2  &mt F13 F3  &kp F10                      &trans  &trans  &trans  &trans  &trans
&trans  &kp F4      &kp F5      &kp F6      &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F7      &kp F8      &kp F9      &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans      &trans      &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        NUM {
            bindings = <
&esc_hold ESCAPE JP_PLUS  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0                                   &kp JP_LBRACE    &kp JP_RBRACE    &kp SLASH      &kp JP_YEN        &trans
&kp MINUS                 &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PERIOD       &trans            &kp JP_COLON   &kp JP_LPAREN    &kp JP_RPAREN    &kp LESS_THAN  &kp GREATER_THAN  &kp JP_TILDE
&mt LSHIFT JP_ASTERISK    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp HASH         &kp JP_EQUAL      &kp SEMICOLON  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp LESS_THAN  &kp GREATER_THAN  &trans
&mt LCTRL SLASH           &kp PERCENT      &kp JP_CARET     &trans           &trans           &trans            &kp BACKSPACE  &trans                                                             &kp DELETE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &kp LG(D)       &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL       &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&esc_hold_to0 ESCAPE Q  &to_layer_0 W  &to_layer_0 E  &to_layer_0 R  &to_layer_0 T                             &to_layer_0 Y  &to_layer_0 U      &to_layer_0 I      &to_layer_0 O       &to_layer_0 P
&to_layer_0 A           &to_layer_0 S  &to_layer_0 D  &to_layer_0 F  &to_layer_0 G  &trans             &trans  &to_layer_0 H  &mkp_exit_AML MB1  &mkp_exit_AML MB2  &to_layer_0 LC(F1)  &mo 6
&kp LEFT_SHIFT          &to_layer_0 Z  &to_layer_0 X  &to_layer_0 C  &to_layer_0 V  &to_layer_0 B      &trans  &to_layer_0 N  &to_layer_0 LC(C)  &to_layer_0 LC(V)  &to_layer_0 PERIOD  &to_layer_0 QUESTION
&kp LCTRL               &trans         &trans         &trans         &trans         &trans             &trans  &trans                                                                   &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // クリック直後の1秒間だけ使うレイヤー。中身は MOUSE と同じにしておく。

        MOUSE_AFTER_CLICK {
            bindings = <
&esc_hold_to0 ESCAPE Q  &to_layer_0 W  &to_layer_0 E  &to_layer_0 R  &to_layer_0 T                             &to_layer_0 Y  &to_layer_0 U      &to_layer_0 I      &to_layer_0 O       &to_layer_0 P
&to_layer_0 A           &to_layer_0 S  &to_layer_0 D  &to_layer_0 F  &to_layer_0 G  &trans             &trans  &to_layer_0 H  &mkp_exit_AML MB1  &mkp_exit_AML MB2  &to_layer_0 LC(F1)  &mo 6
&kp LEFT_SHIFT          &to_layer_0 Z  &to_layer_0 X  &to_layer_0 C  &to_layer_0 V  &to_layer_0 B      &trans  &to_layer_0 N  &to_layer_0 LC(C)  &to_layer_0 LC(V)  &to_layer_0 PERIOD  &to_layer_0 QUESTION
&kp LCTRL               &trans         &trans         &trans         &trans         &trans             &trans  &trans                                                                   &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
